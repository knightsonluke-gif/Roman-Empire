<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Roman Empire Faction – Torn</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <style>
    /* ===== GLOBAL ===== */
    body {
      margin: 0;
      background: #0a0a0a;
      color: #e8e8e8;
      font-family: "Inter", Arial, sans-serif;
    }

    .container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 30px 20px 60px;
    }

    /* ===== HERO ===== */
    .hero-wrapper {
      position: relative;
      margin-bottom: 40px;
    }

    .hero {
      width: 100%;
      border-radius: 8px;
      border: 3px solid #d4af37;
      box-shadow: 0 0 40px rgba(212,175,55,0.4);
    }

    .hero-title {
      position: absolute;
      bottom: 20px;
      left: 20px;
      background: rgba(0,0,0,0.55);
      padding: 12px 20px;
      border-left: 4px solid #d4af37;
      font-size: 1.4rem;
      font-weight: bold;
      color: #f0e6c8;
      border-radius: 4px;
    }

    /* ===== HEADERS ===== */
    h1 {
      font-family: "Georgia", serif;
      font-size: 3rem;
      color: #d4af37;
      text-align: center;
      letter-spacing: 0.12em;
      margin: 10px 0 5px;
      text-transform: uppercase;
    }

    .motto {
      text-align: center;
      font-size: 1.2rem;
      color: #f0e6c8;
      font-style: italic;
      margin-bottom: 40px;
    }

    /* ===== SECTION ===== */
    .section {
      margin: 40px 0;
      padding: 25px 20px;
      background: #111;
      border: 1px solid #333;
      border-radius: 10px;
      box-shadow: 0 0 20px rgba(0,0,0,0.4);
    }

    .section-title {
      font-family: "Georgia", serif;
      font-size: 2rem;
      color: #d4af37;
      margin-bottom: 20px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      text-align: center;
    }

    ul {
      list-style: none;
      padding: 0;
      max-width: 650px;
      margin: 0 auto;
    }

    li {
      font-size: 1.15rem;
      padding: 10px 0;
      border-bottom: 1px solid #333;
      color: #e0e0e0;
    }

    li:last-child {
      border-bottom: none;
    }

    /* ===== BUTTON ===== */
    .cta {
      display: block;
      width: fit-content;
      margin: 40px auto 20px;
      padding: 16px 40px;
      background: #d4af37;
      color: #000;
      font-weight: bold;
      font-size: 1.3rem;
      border-radius: 999px;
      text-decoration: none;
      box-shadow: 0 0 25px rgba(212,175,55,0.7);
      transition: 0.25s ease;
    }

    .cta:hover {
      transform: translateY(-4px);
      box-shadow: 0 0 35px rgba(212,175,55,1);
    }

    /* ===== CONTACT ===== */
    .contact {
      text-align: center;
      font-size: 1rem;
      color: #f0e6c8;
      margin-top: 10px;
    }

    /* ===== FOOTER ===== */
    footer {
      text-align: center;
      margin-top: 50px;
      font-size: 0.85rem;
      color: #777;
    }
  </style>
</head>

<body>
  <div class="container">

    <!-- HERO -->
    <div class="hero-wrapper">
      <img
        class="hero"
        src="https://i.postimg.cc/ykvTxc6c/1000011614-LE-upscale-balanced.jpg"
        alt="Roman Empire Faction Poster"
      >
      <div class="hero-title">Roman Empire Faction</div>
    </div>

    <!-- TITLE -->
    <h1>Roman Empire</h1>
    <div class="motto">Honor in Battle, Power in Unity</div>

    <!-- REQUIREMENTS -->
    <div class="section">
      <div class="section-title">Requirements</div>
      <ul>
        <li>Active, participates in faction events</li>
        <li>Level 15+</li>
        <li>20K+ stats</li>
        <li>Younger than six months</li>
      </ul>
    </div>

    <!-- BENEFITS -->
    <div class="section">
      <div class="section-title">Benefits</div>
      <ul>
        <li>Active Faction</li>
        <li>Good Community</li>
        <li>Occasional warring (22k respect, Silver)</li>
        <li>Advice</li>
        <li>Low pressure and good for progression</li>
      </ul>
    </div>

    <!-- BUTTON -->
    <a
      class="cta"
      href="https://www.torn.com/profiles.php?XID=4368899"
      target="_blank"
    >
      Join Roman Empire
    </a>

    <!-- CONTACT -->
    <div class="contact">
      Message Gansta‑Paradice [4368899] for more details.
    </div>

    <!-- FOOTER -->
    <footer>
      Roman Empire Faction · Torn Online Game · Est. 2026
    </footer>

  </div>
</body>
</html>
